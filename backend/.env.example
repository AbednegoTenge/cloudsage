# CloudSage backend configuration. Copy to .env for local development.
CLOUDSAGE_ENVIRONMENT=local
CLOUDSAGE_LOG_LEVEL=INFO
CLOUDSAGE_CORS_ORIGINS=http://localhost:5173

# PostgreSQL
CLOUDSAGE_DATABASE_URL=postgresql+psycopg://cloudsage:cloudsage@localhost:5432/cloudsage
CLOUDSAGE_DATABASE_POOL_SIZE=5
CLOUDSAGE_DATABASE_ECHO=false
# Used by the test suite (truncated on every run). Never point this at real data.
CLOUDSAGE_TEST_DATABASE_URL=postgresql+psycopg://cloudsage:cloudsage@localhost:5432/cloudsage_test

# Authentication. "dev" identifies callers by the X-CloudSage-User email header (local only;
# refused in production). "oidc" arrives with security hardening (Phase 7).
CLOUDSAGE_AUTH_MODE=dev
CLOUDSAGE_DEV_DEFAULT_USER_EMAIL=engineer@example.com

# AWS access: "mock" needs no AWS account; "live" assumes the IAM role stored on each
# AWS connection via STS (temporary credentials only, never long-lived keys).
CLOUDSAGE_AWS_MODE=mock
CLOUDSAGE_AWS_STS_SESSION_DURATION_SECONDS=900

# Amazon Bedrock. Supplied per environment; never hardcoded. Credentials come from the standard
# AWS chain (IAM role, SSO profile); never put access keys here.
# Check access with: uv run python -m app.agent.check
CLOUDSAGE_BEDROCK_MODEL_ID=
CLOUDSAGE_BEDROCK_REGION=
CLOUDSAGE_BEDROCK_MAX_TOKENS=4096
CLOUDSAGE_BEDROCK_TEMPERATURE=0.0
CLOUDSAGE_BEDROCK_TIMEOUT_SECONDS=60
# Optional Amazon Bedrock Guardrail (set both or neither)
CLOUDSAGE_BEDROCK_GUARDRAIL_ID=
CLOUDSAGE_BEDROCK_GUARDRAIL_VERSION=
# Maximum characters of each piece of evidence shown to the model
CLOUDSAGE_AGENT_MAX_EVIDENCE_CHARS=12000

# Investigation limits
CLOUDSAGE_INVESTIGATION_TIMEOUT_SECONDS=300
CLOUDSAGE_INVESTIGATION_MAX_TOOL_CALLS=25
CLOUDSAGE_INVESTIGATION_MAX_TIME_RANGE_HOURS=168
CLOUDSAGE_SSE_POLL_INTERVAL_SECONDS=1.0
# Run queued investigations in the API process (false: leave them queued for another worker)
CLOUDSAGE_INVESTIGATION_AUTOSTART=true
CLOUDSAGE_INVESTIGATION_MAX_CONCURRENT=4
# Per tool call
CLOUDSAGE_TOOL_TIMEOUT_SECONDS=30
CLOUDSAGE_TOOL_MAX_OUTPUT_CHARS=200000
