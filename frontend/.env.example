# CloudSage frontend configuration (Vite exposes only VITE_* variables to the browser).
# Base URL of the CloudSage backend API.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# "true" serves canned data from src/mocks so the UI runs without the backend.
# "false" uses the real API at VITE_API_BASE_URL.
VITE_USE_MOCKS=true
